{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": [
    "node_modules",
    "api-client-react",
    "api-server",
    "api-spec",
    "api-zod",
    "db",
    "integrations-openai-ai-server",
    "generated-artifacts"
  ],
  "references": [
    {
      "path": "./api-client-react"
    }
  ]
}
