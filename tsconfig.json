{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "references": [
    {
      "path": "./api-client-react"
    },
    {
      "path": "./reader-core"
    }
  ],
  "exclude": [
    "node_modules",
    "api-server",
    "api-client-react",
    "api-spec",
    "api-zod",
    "db",
    "integrations-openai-ai-server",
    "reader-core",
    "generated-artifacts"
  ]
}
